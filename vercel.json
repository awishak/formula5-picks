{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/standings",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/pools",
      "schedule": "0 15 * * 2"
    },
    {
      "path": "/api/cron/fernolo",
      "schedule": "0 3 * * *"
    }
  ]
}
